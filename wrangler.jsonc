{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyre-web",
  "compatibility_date": "2026-08-17",
  "main": "./workers/app.ts",
  "preview_urls": true,
  "vars": {
    "API_ORIGIN": "http://127.0.0.1:3000",
    "APP_ENV": "local",
    "APP_ORIGIN": "http://localhost:5173",
    "DEPLOYMENT_COMMIT": "local",
    "DEPLOYMENT_VERSION": "local",
    "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
  },
  "env": {
    "e2e": {
      "vars": {
        "API_ORIGIN": "http://127.0.0.1:3100",
        "APP_ENV": "local",
        "APP_ORIGIN": "http://localhost:5173",
        "DEPLOYMENT_COMMIT": "local",
        "DEPLOYMENT_VERSION": "local",
        "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
      }
    },
    "preview": {
      "vars": {
        "API_ORIGIN": "https://staging-api.invalid",
        "APP_ENV": "preview",
        "APP_ORIGIN": "https://preview.invalid",
        "DEPLOYMENT_COMMIT": "local",
        "DEPLOYMENT_VERSION": "local",
        "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
      }
    },
    "development": {
      "vars": {
        "API_ORIGIN": "https://hyre-worker-nestjs.fly.dev",
        "APP_ENV": "development",
        "APP_ORIGIN": "https://hyre-web-development.tripdly.workers.dev",
        "DEPLOYMENT_COMMIT": "local",
        "DEPLOYMENT_VERSION": "local",
        "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
      }
    },
    "production": {
      "vars": {
        "API_ORIGIN": "https://hyre-worker-nestjs-production.fly.dev",
        "APP_ENV": "production",
        "APP_ORIGIN": "https://tripdly.com",
        "DEPLOYMENT_COMMIT": "local",
        "DEPLOYMENT_VERSION": "local",
        "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
