{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyre-web",
  "compatibility_date": "2026-08-17",
  "main": "./workers/app.ts",
  "vars": {
    "API_ORIGIN": "http://127.0.0.1:3000",
    "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
  },
  "observability": {
    "enabled": true
  }
}
