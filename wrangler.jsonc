{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyre-web",
  "compatibility_date": "2026-08-17",
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
  },
  "env": {
    "production": {
      "vars": {
        "API_ORIGIN": "https://hyre-worker-nestjs.fly.dev",
        "VALUE_FROM_CLOUDFLARE": "Hyre Web is running on Cloudflare"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
