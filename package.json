{
  "name": "hyre-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "react-router build",
    "check:bundle": "node scripts/check-worker-bundle.mjs",
    "dev": "react-router dev",
    "deploy": "CLOUDFLARE_ENV=production pnpm run build && pnpm run check:bundle && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "cf-typegen": "wrangler types --env production",
    "typecheck": "wrangler types --env production && react-router typegen && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "husky",
    "postinstall": "wrangler types --env production"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
