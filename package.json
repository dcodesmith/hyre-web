{
  "name": "hyre-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "react-router build",
    "check:bundle": "node scripts/check-worker-bundle.mjs",
    "dev": "react-router dev",
    "deploy": "CLOUDFLARE_ENV=production pnpm run build && pnpm run check:bundle && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "cf-typegen": "wrangler types --env production",
    "typecheck": "wrangler types --env production && react-router typegen && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:update": "node scripts/run-e2e.mjs --update-snapshots",
    "prepare": "husky",
    "postinstall": "wrangler types --env production"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.35.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.6"
    }
  }
}
