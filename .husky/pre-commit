set -e

# Validate staged source files only. Do not format or git add — that can
# commit unstaged hunks. Skip when the index has no Biome-processable files;
# otherwise `biome check --staged` fails with "No files were processed".
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|jsonc)$' || true)
if [ -z "$files" ]; then
  exit 0
fi

pnpm exec biome check --staged
